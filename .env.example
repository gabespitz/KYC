# Anthropic API key for Claude (required)
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model overrides (optional)
ANTHROPIC_MODEL_RESEARCH=claude-sonnet-4-6
ANTHROPIC_MODEL_REDLINE=claude-opus-4-6
ANTHROPIC_MODEL_HANDOFF=claude-sonnet-4-6

# SQLite database (Prisma)
DATABASE_URL="file:./dev.db"

# Local file storage root (relative to project)
KYC_UPLOAD_DIR=./uploads

# Coderfull integration mode: "mock" | "live" (live not yet implemented)
CODERFULL_MODE=mock
